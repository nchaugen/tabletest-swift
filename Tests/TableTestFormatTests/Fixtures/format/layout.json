  {"name": "Starts every row at the start of its line", "rule": "row-layout", "source": "FEATURES.md#row-alignment", "input": ["    a|b", "longer value|d", "        x|y"], "expect": {"output": ["a            | b", "longer value | d", "x            | y"]}},
