  {"name": "Pads each column to its widest cell", "rule": "column-width", "source": "TableTestFormatterTest#shouldFormatTableWithColumnAlignment", "input": ["name|age", "Alice|30", "Bob|25", ""], "expect": {"output": ["name  | age", "Alice | 30", "Bob   | 25", ""]}},
