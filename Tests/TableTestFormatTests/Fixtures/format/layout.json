  {"name": "Ends a row with a pipe when its last cell is blank", "rule": "row-layout", "source": "FEATURES.md#empty-cell-handling", "input": ["a|b|c", "x|y|"], "expect": {"output": ["a | b | c", "x | y |"]}},
