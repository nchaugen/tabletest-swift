  {"name": "Keeps a pipe inside quotes in its cell", "rule": "cell-text", "source": "CellFormattingTest#preservesQuotedValues", "input": ["v|w", "'a|b'|c"], "expect": {"output": ["v     | w", "'a|b' | c"]}},
  {"name": "Keeps a backslash as text", "rule": "cell-text", "source": "CellFormattingTest#preservesQuotedValues", "input": ["v|w", "\\uZZZZ|x"], "expect": {"output": ["v      | w", "\\uZZZZ | x"]}},
  {"name": "Keeps one quote style inside the other", "rule": "cell-text", "source": "CellFormattingTest#shouldPreserveMixedQuoteStylesWithinCell", "input": ["name|message", "test|'He said \"hello\"'"], "expect": {"output": ["name | message", "test | 'He said \"hello\"'"]}},
  {"name": "Keeps an unmatched quote as text", "rule": "cell-text", "source": "CellFormattingTest#shouldPreserveUnmatchedSingleQuote", "input": ["name|value", "test|'unclosed", "more|\"open"], "expect": {"output": ["name | value", "test | 'unclosed", "more | \"open"]}},
  {"name": "Keeps the quotes of elements", "rule": "cell-text", "source": "CellFormattingTest#shouldPreserveQuotedElementsInsideCollections", "input": ["col", "[unquoted,'with|pipe', \"with]bracket\"]"], "expect": {"output": ["col", "[unquoted, 'with|pipe', \"with]bracket\"]"]}},
  {"name": "Keeps the quotes of map keys", "rule": "cell-text", "source": "CellFormattingTest#normalisesCollectionValues", "input": ["v", "['[a]':1,\",b,\":2, 'c' : 3]"], "expect": {"output": ["v", "['[a]': 1, \",b,\": 2, 'c': 3]"]}},
