  {"name": "Spaces three levels of nesting", "rule": "cell-text", "source": "CellFormattingTest", "input": ["v", "[a:{[1,2]},b:{[3,4]}]"], "expect": {"output": ["v", "[a: {[1, 2]}, b: {[3, 4]}]"]}},
  {"name": "Spaces a map inside a list", "rule": "cell-text", "source": "CellFormattingTest", "input": ["v", "[[a:1],[b:2]]"], "expect": {"output": ["v", "[[a: 1], [b: 2]]"]}},
